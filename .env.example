NODE_ENV=development
PORT=3000
# Browser origins allowed for CORS and cross-origin POST/PUT/PATCH/DELETE (CSRF).
# Comma-separated, no paths. Empty: same-origin only.
# CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=
# Log levels: a level and above (warn), a list (warn,error) or a threshold (>=warn)
# NEST_LOG_LEVEL=>=log

# Postgres (`docker compose up -d` starts one with this URL)
DATABASE_URL=postgres://app:app@localhost:5432/app

# Redis for BullMQ queues (`docker compose up -d` starts one on localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Mail: "file" writes .eml files to var/mail, "smtp" sends through MAIL_SMTP_URL
MAIL_TRANSPORT=file
MAIL_FROM=App <no-reply@example.com>
# MAIL_SMTP_URL=smtp://user:pass@smtp.example.com:587

# Storage: "local" keeps files in STORAGE_LOCAL_ROOT, "s3" uses any S3-compatible store
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=var/storage
# STORAGE_S3_BUCKET=my-bucket
# STORAGE_S3_REGION=us-east-1            # "auto" for Cloudflare R2
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_FORCE_PATH_STYLE=false      # true for MinIO
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
